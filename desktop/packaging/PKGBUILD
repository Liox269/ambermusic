pkgname=ambermusic-git
pkgver=0.1.0
pkgrel=1
pkgdesc='Local music player for Wayland with MPRIS integration'
arch=('x86_64')
license=('MIT')
depends=('gtk4' 'libadwaita' 'gstreamer' 'gst-plugins-base' 'pipewire' 'sqlite3' 'dbus')
makedepends=('cargo')
source=()

build() {
  cargo build --release --manifest-path "$srcdir/desktop/Cargo.toml" --features linux-ui
}

package() {
  install -Dm755 "$srcdir/target/release/ambermusic" "$pkgdir/usr/bin/ambermusic"
  install -Dm644 "$srcdir/desktop/packaging/ambermusic.desktop" \
    "$pkgdir/usr/share/applications/ambermusic.desktop"
}
