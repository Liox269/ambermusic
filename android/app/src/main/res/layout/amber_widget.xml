<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/amber_widget_root"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView android:id="@+id/widget_cover" android:src="@mipmap/ic_launcher"
            android:contentDescription="Carátula" android:scaleType="centerCrop"
            android:layout_width="58dp" android:layout_height="58dp"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="10dp" android:paddingEnd="4dp">
            <TextView android:id="@+id/widget_title" android:text="AmberMusic"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/widget_artist" android:text="Música offline"
                android:textColor="#F1B0C6" android:textSize="11sp"
                android:maxLines="1" android:ellipsize="end"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:text="AIGIS EDITION" android:textColor="#967685"
                android:textSize="9sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView android:id="@+id/widget_previous" android:text="◀◀" android:textColor="#FFFFFF"
            android:textSize="17sp" android:gravity="center" android:contentDescription="Anterior"
            android:layout_width="37dp" android:layout_height="52dp"/>
        <TextView android:id="@+id/widget_play" android:text="▶" android:textColor="#F4B0C6"
            android:textSize="27sp" android:gravity="center" android:contentDescription="Reproducir o pausar"
            android:layout_width="38dp" android:layout_height="52dp"/>
        <TextView android:id="@+id/widget_next" android:text="▶▶" android:textColor="#FFFFFF"
            android:textSize="17sp" android:gravity="center" android:contentDescription="Siguiente"
            android:layout_width="37dp" android:layout_height="52dp"/>
    </LinearLayout>
</LinearLayout>
